# Meta Developer App Dashboard에서 확인
# App Dashboard > App Settings > Basic > Threads App ID
THREADS_APP_ID=your_app_id_here

# App Dashboard > App Settings > Basic > Threads App Secret
THREADS_APP_SECRET=your_app_secret_here

# OAuth Redirect URI (앱 대시보드에 등록한 것과 동일해야 함)
REDIRECT_URI=http://localhost:8888/callback

# 아래는 auth.py 실행 후 자동으로 채워짐
ACCESS_TOKEN=
USER_ID=

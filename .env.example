# Meta Developer App Dashboard에서 확인
# App Dashboard > App Settings > Basic > Threads App ID
THREADS_APP_ID=your_app_id_here

# App Dashboard > App Settings > Basic > Threads App Secret
THREADS_APP_SECRET=your_app_secret_here

# OAuth Redirect URI (앱 대시보드에 등록한 것과 동일해야 함, HTTPS 필수)
REDIRECT_URI=https://localhost:8888/callback

# 아래는 auth.py / refresh_token.py 실행 후 자동으로 채워짐
ACCESS_TOKEN=
USER_ID=
TOKEN_EXPIRES_AT=

# 인사이트 캐시 TTL(일). 0=만료 없음. 기본 7일 — 만료 시 재조회
INSIGHTS_CACHE_TTL_DAYS=7

# API 재시도 횟수 (429/5xx/타임아웃)
API_MAX_RETRIES=3

# 토큰 만료 N일 전 경고
TOKEN_WARN_DAYS=7

# 리포트 출력 언어: ko(기본) / en / ja. export_excel.py --lang 이 우선
THREADS_LANG=ko
